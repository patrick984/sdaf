<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.57.17" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Sdaf/Sdaf.csproj" />
    <ProjectReference Include="../Sdaf.Cli/Sdaf.Cli.csproj" />
    <Content Include="../../../spec/sdaf-conformance/**/*.sdaf" Link="fixtures/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
